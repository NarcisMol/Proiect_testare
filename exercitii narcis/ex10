public class Main {
    public static void main(String[] args) {
        System.out.println("Luna 2 are " + tipZile(2) + " zile.");   
        System.out.println("Luna 7 are " + tipZile(7) + " zile.");
        System.out.println("Luna 11 are " + tipZile(11) + " zile.");
    }

    public static int tipZile(int luna) {
        switch (luna) {
            case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                return 31;
            case 4: case 6: case 9: case 11:
                return 30;
            case 2:
                return 28;
            default:
                return -1;
        }
    }
}