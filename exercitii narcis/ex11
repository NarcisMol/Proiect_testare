public class Main {
    public static void main(String[] args) {
        System.out.println("Luna 1 are " + tipZile(1) + " zile.");
        System.out.println("Luna 2 are " + tipZile(2) + " zile.");
        System.out.println("Luna 4 are " + tipZile(4) + " zile.");
        System.out.println("Luna 13 are " + tipZile(13) + " zile.");
    }

    public static int tipZile(int luna) {
        switch (luna) {
            case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                return 31;
            case 4: case 6: case 9: case 11:
                return 30;
            case 2:
                return 28; 
            default:
                return -1;
        }
    }
}